 const prof=staff?{email:loginEmail,name:'Demo Lecturer',role:'staff',id:'S026',programme:'',level:0,passport:''}:{email:loginEmail||'demo@example.com',name:'John Doe',role:'student',id:'KSU/26/CS/001',programme:'Computer Science',level:100,passport:''};
 switch(p.action){
  case 'requestCode':loginEmail=p.email;return{ok:true};
  case 'verify':loginEmail=p.email;return p.code==='123456'?{ok:true,token:'demo',profile:demo({action:'x'}).profile||prof}:{ok:false,error:'invalid'};
  case 'dashboard':return{ok:true,profile:prof,session:'2026/2027',courses:DEMO.courses,registered:staff?[]:DEMO.regs.slice(),notices:DEMO.notices};
