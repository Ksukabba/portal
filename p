 p=Object.assign({action,token},p||{});
 if(!API_URL)return Promise.resolve(demo(p));
 return fetch(API_URL,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(p)}).then(r=>{if(!r.ok)throw new Error('net');return r.json()})}
