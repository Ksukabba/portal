 const inst={};list.forEach(c=>{if(c.instructor)(inst[c.instructor]=inst[c.instructor]||[]).push(c.code)});
 $('dash-inst').innerHTML=Object.keys(inst).length?Object.keys(inst).map((n,i)=>'<div class="irow" data-s="'+esc(n.toLowerCase())+'"><span class="ia a'+(i%2)+'">'+esc(initials(n))+'</span><span><b>'+esc(n)+'</b><small>'+esc(inst[n].join(', '))+'</small></span></div>').join(''):'<p class="empty">Instructors appear here.</p>';
 $('dash-notices').innerHTML=D.notices.length?D.notices.slice(0,3).map(n=>noticeItem(n,false)).join(''):'<p class="empty">No notices yet.</p>';}
function drawRegistration(){const sem=+$('rg-sem').value;let rows='';
 D.courses.filter(c=>c.semester===sem).forEach(c=>{const on=D.registered.includes(c.code);
  rows+='<tr data-s="'+esc((c.code+' '+c.title).toLowerCase())+'"><td>'+esc(c.code)+'</td><td>'+esc(c.title)+'</td><td>'+c.units+'</td><td><button type="button" class="tbtn'+(on?' on':'')+'" data-c="'+esc(c.code)+'">'+(on?'Drop':'Register')+'</button></td></tr>'});
 $('rg-list').innerHTML=rows||'<tr><td colspan="4">No courses are available for your level and programme yet.</td></tr>';
 $('rg-units').textContent='Registered units this semester: '+units(regCourses().filter(c=>c.semester===sem));
 $('rg-sess').textContent=(D.session||'')+' session'}
function drawMyCourses(){[1,2].forEach(s=>{const l=regCourses().filter(c=>c.semester===s);
 $('mc-'+s).innerHTML=l.length?l.map(c=>'<tr data-s="'+esc((c.code+' '+c.title).toLowerCase())+'"><td>'+esc(c.code)+'</td><td>'+esc(c.title)+'</td><td>'+c.units+'</td><td>'+esc(c.instructor)+'</td></tr>').join('')+'<tr class="tot"><td colspan="2">Total units</td><td colspan="2">'+units(l)+'</td></tr>':'<tr><td colspan="4">No courses registered.</td></tr>'})}
function drawNotices(){$('nt-list').innerHTML=D.notices.length?D.notices.map(n=>noticeItem(n,true)).join(''):'<p class="empty">No notices yet.</p>'}
function drawStaff(){const s=$('st-course');s.innerHTML='<option value="">Choose a course</option>'+D.courses.map(c=>'<option value="'+esc(c.code)+'">'+esc(c.code)+' – '+esc(c.title)+'</option>').join('');$('st-list').innerHTML='';$('st-count').textContent='';staffRows=[]}
function drawAll(){drawShell();drawDashboard();if(isStaff())drawStaff();else{drawRegistration();drawMyCourses()}drawNotices()}

function section(){const id=location.hash.slice(1);if(!SEC[id]||!K.profile)return;
 const st=isStaff();
 if((st&&STUDENT_ONLY.includes(id))||(!st&&STAFF_ONLY.includes(id))){location.hash='#dashboard';return}
 document.querySelectorAll('.ps').forEach(s=>s.hidden=s.id!==SEC[id]);
 document.querySelectorAll('#pnav a').forEach(a=>a.classList.toggle('on',a.dataset.p===id));
 $('psearch').value='';filterSearch()}
function filterSearch(){const q=$('psearch').value.trim().toLowerCase();document.querySelectorAll('.ps:not([hidden]) [data-s]').forEach(e=>{e.hidden=!!q&&!e.dataset.s.includes(q)})}
$('psearch').addEventListener('input',filterSearch);

/* ---- course details dialog ---- */
document.addEventListener('click',e=>{const b=e.target.closest('[data-view]');if(!b||!D)return;
 const c=D.courses.find(x=>x.code===b.dataset.view);if(!c)return;
 $('cd-title').textContent=c.code+' – '+c.title;
 $('cd-body').innerHTML='<dt>Units</dt><dd>'+c.units+'</dd><dt>Semester</dt><dd>'+(c.semester===2?'Second':'First')+'</dd><dt>Level</dt><dd>'+(c.level||'-')+'</dd><dt>Programme</dt><dd>'+esc(c.programme||'All programmes')+'</dd><dt>Instructor</dt><dd>'+esc(c.instructor||'-')+'</dd>';
 const d=$('cdlg');if(d.showModal)d.showModal();else d.setAttribute('open','')});
$('cd-close').addEventListener('click',()=>{const d=$('cdlg');if(d.close)d.close();else d.removeAttribute('open')});

/* ---- registration actions ---- */
$('rg-sem').addEventListener('change',drawRegistration);
$('rg-list').addEventListener('click',e=>{const b=e.target.closest('button[data-c]');if(!b)return;
 const code=b.dataset.c,on=D.registered.includes(code),msg=$('rg-msg');b.disabled=true;msg.textContent='';
 call(on?'drop':'register',{code}).then(r=>{if(!r.ok)throw new Error(r.error);D.registered=r.registered;drawRegistration();drawMyCourses();drawDashboard()})
 .catch(()=>{msg.textContent='That didn’t work. Please try again.';b.disabled=false})});

/* ---- staff: registered students ---- */
let staffRows=[];
$('st-course').addEventListener('change',()=>{const code=$('st-course').value;
 if(!code){$('st-list').innerHTML='';$('st-count').textContent='';staffRows=[];return}
 $('st-count').textContent='Loading…';
 call('students',{code}).then(r=>{if(!r.ok)throw new Error(r.error);staffRows=r.students;
  $('st-list').innerHTML=staffRows.map(s=>'<tr data-s="'+esc((s.name+' '+s.id).toLowerCase())+'"><td>'+esc(s.id)+'</td><td>'+esc(s.name)+'</td><td>'+esc(s.programme)+'</td><td>'+esc(s.level)+'</td></tr>').join('')||'<tr><td colspan="4">No students have registered for this course yet.</td></tr>';
  $('st-count').textContent=staffRows.length+' registered student'+(staffRows.length===1?'':'s')}).catch(()=>{$('st-count').textContent='Couldn’t load the list. Please try again.'})});
$('st-csv').addEventListener('click',()=>{if(!staffRows.length)return;
 const q=v=>{let s=String(v==null?'':v);if(/^[=+\-@]/.test(s))s="'"+s;return '"'+s.replace(/"/g,'""')+'"'};
 const csv=['ID,Name,Programme,Level'].concat(staffRows.map(r=>[r.id,r.name,r.programme,r.level].map(q).join(','))).join('\n');
 const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv'}));a.download='registered-students.csv';a.click()});

/* ---- login: email, then a 6-digit code ---- */
const lm=$('lg-msg');
function step(n){$('lg-form1').hidden=n!==1;$('lg-form2').hidden=n!==2;$('lg-sub').textContent=n===1?'Enter your registered email address and we’ll send you a 6-digit login code.':'Enter the 6-digit code we sent to '+loginEmail+'.'}
function sendCode(btn){
 if(btn)btn.disabled=true;lm.textContent='Sending…';
 return call('requestCode',{email:loginEmail}).then(r=>{
  if(!r.ok){lm.textContent=r.error==='rate'?'Too many requests. Please wait a while and try again.':r.error==='invalid_email'?'Enter a valid email address.':'We couldn’t send the code right now. Please try again later.';return false}
  step(2);lm.textContent='If this email is registered, a code is on its way. Check your inbox and spam folder. It expires in 10 minutes.';$('lg-code').focus();return true})
 .catch(()=>{lm.textContent='Can’t reach the portal right now. Please try again later.'}).then(()=>{if(btn)btn.disabled=false})}
$('lg-form1').addEventListener('submit',e=>{e.preventDefault();loginEmail=$('lg-email').value.trim().toLowerCase();sendCode(e.target.querySelector('button'))});
$('lg-resend').addEventListener('click',e=>{e.preventDefault();sendCode(null)});
$('lg-change').addEventListener('click',e=>{e.preventDefault();$('lg-code').value='';lm.textContent='';step(1)});
$('lg-form2').addEventListener('submit',e=>{e.preventDefault();const btn=e.target.querySelector('button[type=submit]');btn.disabled=true;lm.textContent='Checking…';
 call('verify',{email:loginEmail,code:$('lg-code').value.trim()}).then(r=>{
  if(!r.ok)throw new Error(r.error||'invalid');
  token=r.token;store.set(token);return load()}).then(()=>{
  $('lg-code').value='';$('lg-email').value='';lm.textContent='';step(1);
  if(location.hash==='#dashboard')show();else location.hash='#dashboard'})
 .catch(err=>{lm.textContent=err.message==='locked'?'Too many wrong attempts. Please request a new code.':err.message==='invalid'?'That code isn’t right or has expired.':'Couldn’t sign you in. Please try again.'})
 .then(()=>{btn.disabled=false})});
if(!API_URL)$('lg-demo').hidden=false;

/* ---- session ---- */
function load(){return call('dashboard',{token}).then(r=>{if(!r.ok)throw new Error(r.error||'auth');D=r;K.profile=r.profile;K.user={email:r.profile.email};drawAll();ui()})}
function logout(){const t=token;token='';store.set('');D=null;K.user=null;K.profile=null;ui();call('logout',{token:t}).catch(()=>{});location.hash='#top';show()}
$('logoutBtn').addEventListener('click',logout);
window.addEventListener('hashchange',section);
(token?load().catch(()=>{token='';store.set('')}):Promise.resolve()).then(()=>{K.ready=true;ui();show();section()});
step(1);
})();
</script>
<script>
(function(){const s=[...document.querySelectorAll('.slide')];let i=0;
if(s.length<2||window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
setInterval(()=>{const prev=s[i];i=(i+1)%s.length;const cur=s[i];
s.forEach(x=>x.style.zIndex=0);prev.style.zIndex=1;cur.style.zIndex=2;cur.classList.add('on');
setTimeout(()=>prev.classList.remove('on'),1000)},5000)})();
</script>
</body>
