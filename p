<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kogi State University, Kabba</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bitter:wght@500;700;800&family=Source+Sans+3:wght@400;600&family=Source+Serif+4:wght@400;600&display=swap">
<style>
:root{--green:#c2410c;--green2:#b43a09;--gold:#f0a92a;--bg:#fffaf5;--surface:#ffffff;--sage:#fdebdc;--ink:#2a1a12;--muted:#6b5446;--line:#ecd6c4;--onGreen:#fff8f2;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--green:#5a1f07;--green2:#ff9a5c;--gold:#f0b43a;--bg:#17100b;--surface:#241811;--sage:#2a1c13;--ink:#f6ebe3;--muted:#c9b3a3;--line:#47301f;--onGreen:#fff8f2;color-scheme:dark}}
:root[data-theme="dark"]{--green:#5a1f07;--green2:#ff9a5c;--gold:#f0b43a;--bg:#17100b;--surface:#241811;--sage:#2a1c13;--ink:#f6ebe3;--muted:#c9b3a3;--line:#47301f;--onGreen:#fff8f2;color-scheme:dark}
html{height:100%;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 70px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 "Source Sans 3",system-ui,sans-serif}
h1,h2,h3{font-family:Bitter,Georgia,serif;line-height:1.15;margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.wrap{max-width:1080px;margin:0 auto;padding:0 22px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--green);color:var(--onGreen)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--green);z-index:21}
.bar{display:flex;align-items:center;gap:18px;min-height:62px}
.brand{display:flex;align-items:center;gap:10px;font:700 17px Bitter,serif;text-decoration:none}
.brand img{width:34px;height:42px;object-fit:contain;background:#fff;border-radius:4px;padding:2px}
nav{margin-left:auto;display:flex;gap:4px;flex-wrap:wrap}
nav a{padding:8px 11px;text-decoration:none;font-weight:600;font-size:15px;border-radius:6px}
nav a:hover{background:rgba(255,255,255,.14)}
.hero{background:var(--green);color:var(--onGreen);position:relative;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1.25fr .75fr;gap:40px;align-items:center;padding-top:64px;padding-bottom:72px}
.hero h1{font-size:clamp(34px,5.4vw,58px);font-weight:800;letter-spacing:-.01em}
.hero p{max-width:52ch;font-size:19px;margin:20px 0 28px;color:#ffe9d8}
.btns{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-block;padding:12px 22px;border-radius:6px;font-weight:600;text-decoration:none;border:2px solid var(--gold)}
.btn.gold{background:var(--gold);color:#1b1a10}
.btn.ghost{color:var(--onGreen)}
.btn:hover{filter:brightness(1.08)}
.crest{background:#fff;border-radius:50% 50% 14px 14px;padding:26px 26px 20px;max-width:300px;justify-self:center;border-bottom:8px solid var(--gold)}
.crest img{display:block;width:100%;height:auto}
.furrows{height:14px;background:repeating-linear-gradient(90deg,var(--gold) 0 26px,transparent 26px 40px);opacity:.9}
.quick{margin-top:-1px;background:var(--sage)}
.quick .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:0}
.quick a{padding:22px 18px;text-decoration:none;border-left:1px solid var(--line)}
.quick a:last-child{border-right:1px solid var(--line)}
.quick b{display:block;font:700 18px Bitter,serif}
.quick span{font-size:15px;color:var(--muted)}
.quick a:hover{background:var(--surface)}
section{padding:68px 0}
h2{font-size:clamp(26px,3.6vw,36px);margin-bottom:14px}
.lead{max-width:62ch;color:var(--muted);font-size:18px}
.about{display:grid;grid-template-columns:1fr 1fr;gap:48px}
.motto{border-left:6px solid var(--gold);padding:6px 0 6px 20px;font:700 clamp(22px,3vw,30px)/1.25 Bitter,serif;color:var(--green2)}
.alt{background:var(--sage)}
.fac{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;margin-top:28px}
.fac div{background:var(--surface);padding:22px;border-top:5px solid var(--green2);border-radius:0 0 8px 8px}
.fac h3{font-size:19px;margin-bottom:6px}
.fac p{margin:0;color:var(--muted);font-size:15.5px}
.news{margin-top:24px;border-top:2px solid var(--green2)}
.news a{display:grid;grid-template-columns:130px 1fr;gap:18px;padding:18px 0;border-bottom:1px solid var(--line);text-decoration:none}
.news time{font-weight:600;color:var(--green2)}
.news b{font:700 19px Bitter,serif;display:block}
.news a:hover b{text-decoration:underline}
footer{background:var(--green);color:var(--onGreen);padding:44px 0 34px}
footer .wrap{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:32px}
footer h3{font-size:17px;margin-bottom:10px;color:var(--gold)}
footer p,footer li{margin:0 0 6px;font-size:15.5px;color:#ffe9d8}
footer ul{list-style:none;padding:0;margin:0}
footer a{text-decoration:none}footer a:hover{text-decoration:underline}
.fine{grid-column:1/-1;border-top:1px solid rgba(255,255,255,.2);padding-top:16px;font-size:14px}
.wide{overflow-x:auto}
@media (max-width:820px){
.hero .wrap,.about,footer .wrap{grid-template-columns:1fr}
.crest{max-width:210px;order:-1;justify-self:start}
.quick .wrap{grid-template-columns:1fr 1fr}
.quick a:nth-child(2n){border-right:1px solid var(--line)}
.news a{grid-template-columns:1fr;gap:2px}
nav{display:none}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

:root{--gl:rgba(255,255,255,.58);--gl-line:rgba(255,255,255,.8);--gl-sh:0 8px 30px rgba(10,40,22,.12)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--gl:rgba(36,24,17,.55);--gl-line:rgba(255,255,255,.14);--gl-sh:0 8px 30px rgba(0,0,0,.35)}}
:root[data-theme="dark"]{--gl:rgba(36,24,17,.55);--gl-line:rgba(255,255,255,.14);--gl-sh:0 8px 30px rgba(0,0,0,.35)}
body{background:radial-gradient(480px 400px at 96% 62%,rgba(217,165,32,.28),transparent 70%),radial-gradient(500px 420px at 40% 100%,rgba(234,100,20,.22),transparent 70%),var(--bg);background-attachment:fixed}
header{background:none}
header::before{content:"";position:absolute;inset:0;z-index:-1;background:rgba(150,48,6,.72);-webkit-backdrop-filter:blur(16px) saturate(1.5);backdrop-filter:blur(16px) saturate(1.5);border-bottom:1px solid rgba(255,255,255,.22)}
body::before{background:rgba(150,48,6,.72);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px)}
.hero{--hero:url("data:image/jpeg;base64,");margin-top:-62px;display:flex;flex-direction:column;min-height:min(90vh,740px);background:linear-gradient(90deg,rgba(50,16,3,.88) 0%,rgba(50,16,3,.5) 55%,rgba(50,16,3,.12) 100%),var(--hero) center 60%/cover no-repeat}
.hero .wrap{padding-top:128px;padding-bottom:36px;flex:1}
.hero h1{text-shadow:0 2px 18px rgba(0,0,0,.35);color:#fff}
.btn.ghost{background:rgba(255,255,255,.14);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-color:rgba(255,255,255,.5)}
.hero .crest{background:rgba(255,255,255,.16);-webkit-backdrop-filter:blur(18px) saturate(1.4);backdrop-filter:blur(18px) saturate(1.4);border:1px solid rgba(255,255,255,.4);border-radius:24px;padding:22px;max-width:270px;text-align:center;box-shadow:0 10px 36px rgba(0,0,0,.25);order:0}
.crest img{width:140px;margin:0 auto 14px;background:#fff;border-radius:16px;padding:8px}
.hero .crest p{margin:0;font:700 19px/1.25 Bitter,serif;color:#fff}
.qbar{width:100%;max-width:1080px;margin:0 auto;padding:0 22px 30px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.qbar a{padding:16px 18px;border-radius:18px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.38);-webkit-backdrop-filter:blur(14px) saturate(1.4);backdrop-filter:blur(14px) saturate(1.4);color:#fff;text-decoration:none;box-shadow:0 6px 24px rgba(0,0,0,.18)}
.qbar a:hover{background:rgba(255,255,255,.28)}
.qbar b{display:block;font:700 17px Bitter,serif}
.qbar span{font-size:14.5px;color:#ffe9d8}
.gbtn{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:999px;font:600 15px "Source Sans 3",system-ui,sans-serif;color:#fff;cursor:pointer;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.4);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.gbtn:hover,.gbtn[aria-expanded="true"]{background:rgba(255,255,255,.28)}
.gbtn svg{transition:transform .2s}
#loginBtn[aria-expanded="true"] svg{transform:rotate(180deg)}
.login{position:relative}
.menu{position:absolute;right:0;top:calc(100% + 12px);min-width:230px;padding:8px;border-radius:16px;display:flex;flex-direction:column;gap:2px;background:rgba(150,48,6,.6);-webkit-backdrop-filter:blur(20px) saturate(1.5);backdrop-filter:blur(20px) saturate(1.5);border:1px solid rgba(255,255,255,.3);box-shadow:0 12px 36px rgba(0,0,0,.3)}
.menu[hidden]{display:none}
.menu a{padding:10px 14px;border-radius:10px;text-decoration:none;color:#fff}
.menu a:hover{background:rgba(255,255,255,.18)}
.menu b{display:block;font-weight:600}
.menu span{font-size:14px;color:#ffe3cf}
.burger{display:none;padding:8px 11px}
.alt{background:transparent}
.fac div,.motto,.news{background:var(--gl);-webkit-backdrop-filter:blur(16px) saturate(1.4);backdrop-filter:blur(16px) saturate(1.4);border:1px solid var(--gl-line);box-shadow:var(--gl-sh)}
.fac div{border-top:5px solid var(--green2);border-radius:16px}
.motto{padding:22px 24px;border-radius:16px;border-left:6px solid var(--gold)}
.news{border-radius:18px;padding:4px 26px;border-top:1px solid var(--gl-line)}
.news a:last-child{border-bottom:0}
@media (max-width:820px){
.hero{background-image:linear-gradient(180deg,rgba(50,16,3,.82),rgba(50,16,3,.55)),var(--hero)}
.hero .crest{max-width:none;display:flex;align-items:center;gap:14px;text-align:left;padding:14px}
.crest img{width:64px;margin:0}
.qbar{grid-template-columns:1fr 1fr}
.burger{display:inline-flex}
.login{margin-left:auto}
header.open nav{display:flex;flex-direction:column;position:absolute;left:12px;right:12px;top:calc(100% + 8px);padding:8px;border-radius:16px;background:rgba(150,48,6,.6);-webkit-backdrop-filter:blur(20px) saturate(1.5);backdrop-filter:blur(20px) saturate(1.5);border:1px solid rgba(255,255,255,.3)}
}

.vcard{display:grid;grid-template-columns:300px 1fr;gap:36px;padding:32px;border-radius:24px;background:var(--gl);-webkit-backdrop-filter:blur(16px) saturate(1.4);backdrop-filter:blur(16px) saturate(1.4);border:1px solid var(--gl-line);box-shadow:var(--gl-sh);align-items:start}
.vcard img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:top;border-radius:18px;border-bottom:6px solid var(--gold);display:block}
.vtext h3{font-size:clamp(22px,3vw,28px);color:var(--green2)}
.vtext .vrole{color:var(--muted);font-weight:600;margin:8px 0 18px}
.vtext p{max-width:68ch;margin:0 0 14px}
.vtext .vrole{max-width:none}
.more summary{list-style:none;display:inline-block;cursor:pointer;padding:9px 18px;border-radius:999px;font-weight:600;color:var(--ink);background:var(--gl);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid var(--gl-line);box-shadow:var(--gl-sh);margin-bottom:16px}
.more summary::-webkit-details-marker{display:none}
.more summary:hover{border-color:var(--gold)}
.more .s-close,.more[open] .s-open{display:none}
.more[open] .s-close{display:inline}
@media (max-width:820px){.vcard{grid-template-columns:1fr;padding:20px}.vcard img{max-width:260px}}

.btn.gold{background:#ff8a2b;border-color:#ff8a2b;color:#1b0e04}
.brand img{width:44px;height:44px;border-radius:50%;padding:2px;object-fit:contain}
.view{padding-top:12px}
#v-home[hidden],.view[hidden]{display:none}
.back{display:inline-block;margin-bottom:18px;font-weight:600;color:var(--green2);text-decoration:none}
.back:hover{text-decoration:underline}
.lcard{max-width:440px;margin:16px auto 0;padding:34px;border-radius:24px;text-align:center;background:var(--gl);-webkit-backdrop-filter:blur(18px) saturate(1.4);backdrop-filter:blur(18px) saturate(1.4);border:1px solid var(--gl-line);box-shadow:var(--gl-sh)}
.llogo{width:96px;height:96px;object-fit:contain;margin-bottom:12px}
.lsub{color:var(--muted);margin:8px 0 22px}
.lform{text-align:left}
.lform label{font-weight:600;font-size:15px}
.lform input{display:block;width:100%;padding:12px 14px;margin:6px 0 16px;border-radius:12px;border:1px solid var(--line);background:var(--gl);color:var(--ink);font:inherit;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.lform .btn{width:100%;cursor:pointer;font:inherit;font-weight:600}
.lmsg{margin:12px 0 0;font-size:15px;color:var(--green2);min-height:1.2em}
.lalt{margin:18px 0 0;font-size:15px;color:var(--muted)}
.lalt a{color:var(--green2);font-weight:600}
.reveal{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
.reveal.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}

:root{--green:#14532d;--green2:#1d6b3b;--orange:#b43a09;--gold:#f0a92a;--bg:#fbfbf6;--sage:#e7f0e1;--ink:#17261c;--muted:#4d5e53;--line:#d9e2d3;--onGreen:#f4f8ef;--hdr:rgba(255,255,255,.6);--hdr-line:rgba(255,255,255,.85);--hover:rgba(23,38,28,.08);--btn:rgba(255,255,255,.55);--menu:rgba(255,255,255,.84)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--green:#0c2a18;--green2:#62c28c;--orange:#ff9a5c;--bg:#0f1712;--surface:#17231b;--sage:#1a2a1f;--ink:#edf3ea;--muted:#aebfb2;--line:#2b3d31;--gl:rgba(23,35,27,.55);--hdr:rgba(16,24,19,.55);--hdr-line:rgba(255,255,255,.14);--hover:rgba(255,255,255,.12);--btn:rgba(255,255,255,.1);--menu:rgba(18,28,22,.86)}}
:root[data-theme="dark"]{--green:#0c2a18;--green2:#62c28c;--orange:#ff9a5c;--bg:#0f1712;--surface:#17231b;--sage:#1a2a1f;--ink:#edf3ea;--muted:#aebfb2;--line:#2b3d31;--gl:rgba(23,35,27,.55);--hdr:rgba(16,24,19,.55);--hdr-line:rgba(255,255,255,.14);--hover:rgba(255,255,255,.12);--btn:rgba(255,255,255,.1);--menu:rgba(18,28,22,.86)}
body{background:radial-gradient(480px 400px at 96% 62%,rgba(240,169,42,.26),transparent 70%),radial-gradient(500px 420px at 40% 100%,rgba(234,100,20,.14),transparent 70%),var(--bg);background-attachment:fixed}
header{color:var(--ink)}
header::before,body::before{background:var(--hdr);-webkit-backdrop-filter:blur(20px) saturate(1.6);backdrop-filter:blur(20px) saturate(1.6)}
header::before{border-bottom:1px solid var(--hdr-line);box-shadow:0 4px 24px rgba(0,0,0,.08)}
.brand img{background:none;padding:0}
nav a:hover,.navbtn:hover,.navbtn[aria-expanded="true"]{background:var(--hover)}
.navbtn{display:inline-flex;align-items:center;gap:6px;padding:8px 11px;border:0;border-radius:6px;background:none;color:inherit;font:600 15px "Source Sans 3",system-ui,sans-serif;cursor:pointer}
.navbtn svg{transition:transform .2s}
.navbtn[aria-expanded="true"] svg{transform:rotate(180deg)}
.dd{position:relative}
.dd .menu{right:auto;left:0;min-width:240px}
.menu{background:var(--menu);border:1px solid var(--hdr-line)}
.menu a{color:var(--ink)}
.menu a:hover{background:var(--hover)}
.menu span{color:var(--muted)}
header .gbtn{color:var(--ink);background:var(--btn);border-color:var(--hdr-line)}
header .gbtn:hover{background:var(--hover)}
header #loginBtn,header #loginBtn:hover,header #loginBtn[aria-expanded="true"]{background:#ff8a2b;border-color:#ff8a2b;color:#1b0e04}
.hero{background:linear-gradient(90deg,rgba(8,44,24,.86) 0%,rgba(8,44,24,.5) 55%,rgba(8,44,24,.12) 100%),var(--hero) center 40%/cover no-repeat}
.qbar a{border-bottom:3px solid #ff8a2b}
footer p,footer li{color:#e4efdc}
.news time,.back,.lalt a,.lmsg{color:var(--orange)}
.fac div:nth-child(even){border-top-color:#e8650a}
.asec h3{font-size:24px;margin:40px 0 14px;color:var(--green2)}
.panel{padding:22px 26px;border-radius:16px;background:var(--gl);-webkit-backdrop-filter:blur(16px) saturate(1.4);backdrop-filter:blur(16px) saturate(1.4);border:1px solid var(--gl-line);box-shadow:var(--gl-sh)}
.panel p{margin:0;color:var(--muted)}
.news .row{display:grid;grid-template-columns:220px 1fr;gap:18px;padding:16px 0;border-bottom:1px solid var(--line)}
.news .row:last-child{border-bottom:0}
.news .row b{font:700 18px Bitter,serif}
@media (max-width:820px){
.hero{background:linear-gradient(180deg,rgba(8,44,24,.8),rgba(8,44,24,.55)),var(--hero) center 40%/cover no-repeat}
header.open nav{background:var(--menu);border:1px solid var(--hdr-line)}
header.open .dd .menu{position:static;margin:4px 0 8px;box-shadow:none;min-width:0}
.news .row{grid-template-columns:1fr;gap:2px}
}

.brand{gap:10px}
.brand img{border-radius:0}
.bname{display:flex;flex-direction:column;line-height:1.15}
.bname b{font:700 15px Bitter,Georgia,serif}
.bname small{font:600 11.5px "Source Sans 3",system-ui,sans-serif;color:var(--muted);letter-spacing:.08em;text-transform:uppercase}
.sub{color:var(--muted);margin:0 0 16px;font-size:15.5px;max-width:70ch}
.progs{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(235px,1fr));gap:12px;counter-reset:p}
.progs li{counter-increment:p;display:flex;gap:10px;align-items:baseline;padding:12px 16px;border-radius:14px;font-size:15px;font-weight:600;background:var(--gl);-webkit-backdrop-filter:blur(16px) saturate(1.4);backdrop-filter:blur(16px) saturate(1.4);border:1px solid var(--gl-line);box-shadow:var(--gl-sh)}
.progs li::before{content:counter(p);font:700 13px Bitter,Georgia,serif;color:var(--orange);min-width:1.5em}
.cal h4{font:700 18px Bitter,Georgia,serif;margin:0 0 10px;color:var(--green2)}
.tw{overflow-x:auto}
.cal table{width:100%;min-width:520px;border-collapse:collapse;font-size:15px}
.cal th{text-align:left;padding:8px 10px;font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border-bottom:2px solid var(--green2)}
.cal td{padding:10px;border-bottom:1px solid var(--line);vertical-align:top}
.cal tr:last-child td{border-bottom:0}
.cal td:first-child{font-weight:600}
.cal td:last-child{white-space:nowrap;color:var(--muted)}
.cnote{font-size:14.5px;color:var(--muted);margin:14px 0 0}
@media (max-width:820px){.bar{gap:10px}.bname b{font-size:14px}.brand img{width:38px;height:38px}}

.fac{grid-template-columns:repeat(auto-fit,minmax(270px,1fr))}
.fac p{font-weight:600;color:var(--ink);margin:0}
.fac ul{margin:8px 0 0;padding-left:18px;color:var(--muted);font-size:15px}
.fac li{margin:3px 0}
.progs b{font-weight:600}
.progs small{display:block;font-weight:400;font-size:12.5px;color:var(--muted);line-height:1.3}

.phead{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:18px}
.gbtn2{padding:9px 18px;border-radius:999px;font:600 15px "Source Sans 3",system-ui,sans-serif;color:var(--ink);cursor:pointer;background:var(--gl);border:1px solid var(--gl-line);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);box-shadow:var(--gl-sh)}
.gbtn2:hover{border-color:var(--gold)}
.ctrl{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:14px}
.ctrl label{font-weight:600}
.ctrl select{padding:9px 12px;border-radius:10px;border:1px solid var(--line);background:var(--gl);color:var(--ink);font:inherit;max-width:100%}
